{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["clean/mobile/src/*"],
      "@screens/*": ["clean/mobile/src/screens/*"],
      "@stacks/*": ["clean/mobile/src/stacks/*"],
      "@components/*": ["clean/mobile/src/components/*"],
      "@api/*": ["clean/mobile/src/api/*"],
      "@storage/*": ["clean/mobile/src/storage/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": []
  },
  "include": ["clean/mobile/**/*"],
  "exclude": ["node_modules", "**/node_modules/*", "dist"]
}
