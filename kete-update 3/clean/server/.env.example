# ─────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.
# Generate each secret with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────

# Admin panel auth
ADMIN_JWT_SECRET=replace-with-openssl-rand-hex-32
ADMIN_SEED_EMAIL=admin@example.org
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# App (mobile) auth — must differ from ADMIN_JWT_SECRET
APP_JWT_SECRET=replace-with-a-different-openssl-rand-hex-32

# Server
PORT=3000
SQLITE_DB_PATH=/app/db/database.db

# Email (magic links + password resets)
# For Gmail this must be an App Password, not the account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_SECURE=false
SMTP_FROM="Kete of Knowledge" <noreply@example.org>

# Admin panel URL, used to build password reset links
ADMIN_APP_URL=http://localhost:5173
