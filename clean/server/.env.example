# ─────────────────────────────────────────────────────────────
# Kete of Knowledge – server environment (EXAMPLE — placeholders only)
# Copy to .env and fill in real values. NEVER commit real secrets.
# Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# Admin JWT auth
ADMIN_JWT_SECRET=replace-with-openssl-rand-hex-32
ADMIN_SEED_EMAIL=admin@example.com
# Use a long, unique password — this account has full admin rights
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# App (mobile) JWT auth — must be different from the admin secret
APP_JWT_SECRET=replace-with-a-different-openssl-rand-hex-32

# Server settings
PORT=3000
NODE_ENV=development
# Path to the SQLite database file. In Docker/production this should point
# at the persistent volume, e.g. /app/data/db/database.db
SQLITE_DB_PATH=./db/database.db

# Where uploaded media is stored. In production point this at the
# persistent volume, e.g. /app/data/uploads — otherwise uploads are
# wiped on every redeploy.
UPLOADS_DIR=./uploads

# CORS: comma-separated list of allowed origins in production,
# e.g. https://your-admin-panel.example.com
# Leave empty in local dev to allow all origins.
ALLOWED_ORIGINS=

# Email Service (Nodemailer) — use an app password or a transactional
# provider (Brevo, SendGrid, Resend, etc). Do not use a personal inbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_SECURE=false
SMTP_FROM="Kete of Knowledge" <no-reply@example.com>

# Admin App UI URL (used in password reset links)
ADMIN_APP_URL=http://localhost:5173
