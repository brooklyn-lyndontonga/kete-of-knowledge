# Vite env vars (available in JS as import.meta.env.VITE_*)
VITE_API_URL=http://localhost:3000

# Auth0 — get these from your Auth0 Dashboard
# Application → Settings → Domain
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# Application → Settings → Client ID
VITE_AUTH0_CLIENT_ID=your_client_id_here
# APIs → your API → Identifier (audience)
VITE_AUTH0_AUDIENCE=https://kete-api.example.com
