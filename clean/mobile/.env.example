# Expo public env vars (available in JS as process.env.EXPO_PUBLIC_*)
# If unset, the app will attempt to use the Expo dev host IP automatically.
# Use your machine's LAN IP for device testing, e.g. http://192.168.1.50:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Auth0 (mobile)
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your_client_id
# Optional: set if using a custom API audience
EXPO_PUBLIC_AUTH0_AUDIENCE=
# Optional: set to force a specific Auth0 connection (e.g., email for passwordless)
EXPO_PUBLIC_AUTH0_CONNECTION=

# Ensure your Auth0 app has this callback URL:
# keteofknowledge://auth
# If using Expo Go, also allow:
# https://auth.expo.io/@YOUR_EXPO_USERNAME/mobile
