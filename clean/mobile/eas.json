{
  "cli": {
    "version": ">= 12.5.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kete-server-production.up.railway.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kete-server-production.up.railway.app"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kete-server-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
