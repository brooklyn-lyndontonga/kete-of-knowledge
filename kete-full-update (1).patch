+
+export default function ConsentScreen({ onAccepted }) {
+  const [saving, setSaving] = useState(false)
+
+  async function accept() {
+    if (saving) return
+    setSaving(true)
+    try {
+      await acceptConsent()
+      onAccepted?.()
+    } catch (err) {
+      console.warn("Could not record consent:", err?.message)
+      setSaving(false)
